# Skill evaluation workspaces — per-iteration run artefacts (transcripts,
# per-run grading, review HTMLs, review server caches). Only the summarised
# benchmark files under claude/skills/<skill>/evals/benchmarks/ enter git.
claude/skills/*-workspace/
codex/skills/*-workspace/
gemini/skills/*-workspace/

# Byte-compiled Python caches (harness scripts are run ad-hoc)
__pycache__/
*.pyc

# Local adversarial review reports and verification output
.reviews/

# Transcript-mining scratch output (episode slices carry private-repo state —
# never committed; the committed deliverable is docs/reports/ + scripts/analysis/)
.analysis-out/

# Local per-task git worktrees
.worktrees/

# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local shell helpers / scratch
*.local
*.local.*

# Local telemetry — untracked per P5 (docs/requirements/canonical-repo.md)
logs/
docs/issues/guard-bypass.log
