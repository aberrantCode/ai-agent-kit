# fleet-llm config template — copy to ~/.claude/fleet-llm.env and fill in.
# (Or just run: python scripts/fleet_llm.py setup --base-url ... --api-key ...)
#
# This file is single-user and must NEVER be committed. The real config lives at
# ~/.claude/fleet-llm.env, outside any repo. Only this .example belongs in git.
#
# Resolution order per key: ~/.claude/fleet-llm.env -> environment variable -> error.

# Open WebUI base URL (fronts ollama). LAN-only, VLAN30.
FLEET_LLM_BASE_URL=http://192.168.30.53:3000

# Service-account bearer token. Sent as: Authorization: Bearer <token>
FLEET_LLM_API_KEY=replace-with-your-token

# Default chat model. Use an explicit tag. Note qwen3.5:* are "thinking" models:
# a low --max-tokens can be consumed by the hidden reasoning pass, leaving content empty.
FLEET_LLM_DEFAULT_MODEL=qwen3.5:9b
